# 应用
APP_ENV=development
APP_DEBUG=true
APP_NAME=出口商品国际市场观测报告工具

# 数据库（三库分离）
# 开发态留空会自动使用 tmpfs 下的 SQLite
DATABASE_TRADE_URL=
DATABASE_USER_URL=
DATABASE_CONTENT_URL=

# JWT
JWT_SECRET=change-me-in-production-min-32-chars-please

# 异步任务
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AI（可选）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_DEFAULT=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# 新闻源（可选，全部留空则走兜底模拟数据）
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_TIMEOUT_SECONDS=30
NEWSAPI_KEY=
BING_NEWS_KEY=
NEWSDATA_KEY=
NEWS_FALLBACK_MOCK=true

# 业务参数
HS_VERSION=HS2022
REPORT_TOP_N=15
REPORT_CHART_TOP_N=5
REPORT_LOOKBACK_MONTHS=6
NEWS_PER_SECTION=5
NEWS_GROWTH_UP_THRESHOLD=10.0
NEWS_GROWTH_DOWN_THRESHOLD=-10.0

# 邀请码
INVITE_CODE_PRICE=568
INVITE_CODE_REPORTS=12

# 定时任务
REPORT_GENERATE_CRON_DAY=25
DATA_READINESS_CHECK_DAY=20

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
