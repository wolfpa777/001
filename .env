# 环境
APP_ENV=development
APP_DEBUG=true

# 三库分离（开发态默认 SQLite 文件，生产态改 PostgreSQL）
DATABASE_TRADE_URL=sqlite:///./data/trade.db
DATABASE_USER_URL=sqlite:///./data/user.db
DATABASE_CONTENT_URL=sqlite:///./data/content.db

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# 认证（生产必须替换）
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_DEFAULT=deepseek-chat
DEEPSEEK_MODEL_PRO=deepseek-chat

# 新闻源（按需配置，未配置自动 mock）
NEWSAPI_KEY=
BING_NEWS_KEY=
NEWSDATA_KEY=
NEWS_FALLBACK_MOCK=true

# 业务
HS_VERSION=HS2022
INVITE_CODE_PRICE=568
INVITE_CODE_REPORTS=12
REPORT_GENERATE_CRON_DAY=25
DATA_READINESS_CHECK_DAY=20

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
